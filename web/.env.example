APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Primary: PostgreSQL (schemas public + audit + logs via migration)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toko_instan
DB_USERNAME=toko
DB_PASSWORD=

# Local-only SQLite fallback (optional). PHPUnit already forces sqlite :memory:.
# Staging/production must use pgsql — see docs/architecture/multi-tenant.md
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Root domain for tenant resolution (subdomain middleware / cookie scope).
# Storefront publik MVP: path-based /{store_slug} — lihat docs/architecture/multi-tenant.md
PLATFORM_BASE_DOMAIN=toko-instan.test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default

# Horizon (Redis-backed queue dashboard) — dev
HORIZON_AUTH_EMAIL=support@tetris.com
HORIZON_ENABLED=true
HORIZON_PREFIX=toko-instan_horizon:

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


RESEND_API_KEY=

# Object storage — Cloudflare R2 (S3-compatible). Use FILESYSTEM_DISK=local if R2 credentials are empty.
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Kosongkan di local/ID — *.r2.dev sering diblokir ISP. App akan proxy via /media/...
# Production: custom domain CDN, mis. https://cdn.domain-kamu.com
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true
R2_HTTP_TIMEOUT=60
R2_CONNECT_TIMEOUT=10

# Fallback S3-compatible disk (MinIO, AWS S3, dll.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Authentication (client-side) — isi sesuai project Firebase kamu
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=your-project-id

# AI copy (P3-001) — fake = tanpa API key. openai | gemini butuh key.
AI_DRIVER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Cloud API (P3-010) — hanya tenant Premium, nomor di Pengaturan Toko
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0

PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=

# Shipping — RajaOngkir (starter) atau Biteship. Kosong = tarif estimasi lokal.
SHIPPING_PROVIDER=rajaongkir
SHIPPING_ORIGIN_CITY="Jakarta Selatan"
SHIPPING_ORIGIN_POSTAL_CODE=12190
SHIPPING_COURIERS=jne:jnt:sicepat
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com

# PPN (persen) untuk seller PKP di checkout
PPN_RATE=11

# Realtime (Laravel Reverb) — dashboard seller
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=toko
REVERB_APP_KEY=toko-key
REVERB_APP_SECRET=toko-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Referral (P3-030)
REFERRAL_COMMISSION_RATE=0.05
REFERRAL_COMMISSION_MAX=50000

# Custom domain Cloudflare (P3-044) — kosong = simpan domain status pending
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

